{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf2-pipeline"
		},
		"LS_AzSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzSQL'"
		},
		"LS_Gen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_Gen2'"
		},
		"LS_AzSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "serverdataops.database.windows.net"
		},
		"LS_AzSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "primarydbdataops"
		},
		"LS_AzSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azsqladmin"
		},
		"LS_Gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://samujahed06dec.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf2-pipeline_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzSQL_password": {
						"value": "[parameters('LS_AzSQL_password')]"
					},
					"LS_Gen2_accountKey": {
						"value": "[parameters('LS_Gen2_accountKey')]"
					},
					"LS_AzSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AzSQL_properties_typeProperties_server')]"
					},
					"LS_AzSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AzSQL_properties_typeProperties_database')]"
					},
					"LS_AzSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzSQL_properties_typeProperties_userName')]"
					},
					"LS_Gen2_properties_typeProperties_url": {
						"value": "[parameters('LS_Gen2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}